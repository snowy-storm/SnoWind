# 正式 Docker 安装请直接使用仓库根目录的 docker-compose.yml，
# 不必复制本文件。本文件仅给从源码本地研发时参考。
#
# 研发：copy .env.dev.example .env.dev   （见 README「本地研发」）

APP_URL=http://localhost:3000
PORT=3000
APP_SECRET=ChangeMeToARandomStringAtLeast32CharsLong
JWT_TOKEN_EXPIRES_IN=30d

POSTGRES_USER=snowind
POSTGRES_PASSWORD=ChangeMeDbPassword2026
POSTGRES_DB=snowind

STORAGE_DRIVER=local
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=SnoWind
DISABLE_TELEMETRY=true

SEARCH_DRIVER=typesense
TYPESENSE_API_KEY=ChangeMeTypesenseKey2026
TYPESENSE_LOCALE=zh

ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=ChangeMeOnlyOfficeJwtSecret32chars
ONLYOFFICE_APP_URL=http://snowind:3000
