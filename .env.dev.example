# Local R&D — copy to `.env.dev` (gitignored).
# Overrides `.env` so `pnpm dev` talks to snowind-dev, not the official stack.
#
# Official stack:  app :3000  db :5435  redis :6379  typesense (internal only)
# This file:       frontend :5173  backend :3010  db :5444  redis :2817  typesense :8109

APP_URL=http://localhost:3010
PORT=3010
CLIENT_PORT=5173

APP_SECRET=snowind_dev_local_secret_change_me_32plus_chars

DATABASE_URL=postgresql://snowind:snowind_dev_db_2026@127.0.0.1:5444/snowind?schema=public
REDIS_URL=redis://:snowind_dev_redis_2026@127.0.0.1:2817

STORAGE_DRIVER=local
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=SnoWind
SEARCH_DRIVER=typesense
TYPESENSE_URL=http://127.0.0.1:8109
TYPESENSE_API_KEY=snowind_typesense_dev_key_2026
TYPESENSE_LOCALE=zh
DISABLE_TELEMETRY=true
DEBUG_MODE=true

# OnlyOffice Document Server (started by docker-compose.dev.yml)
ONLYOFFICE_URL=http://localhost:8088
ONLYOFFICE_JWT_SECRET=snowind_dev_onlyoffice_jwt_secret_32chars
# Document Server runs in Docker and must reach the host backend
ONLYOFFICE_APP_URL=http://host.docker.internal:3010
